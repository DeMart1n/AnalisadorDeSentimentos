JWT_SECRET_KEY=test-secret-key
STANDARD_MODEL=lexico
CELERY_BROKER_URL=redis://localhost:6379/0
# RDS (Postgres). Sem DATABASE_HOST o projeto usa o SQLite local.
DATABASE_HOST=
DATABASE_NAME=analisador
DATABASE_USER=postgres
DATABASE_PASSWORD=
# núcleos da máquina / número de workers
ONNX_THREADS=2
# model.int8.onnx (padrão) ou model.onnx (fp32, idêntico ao torch)
BERTIMBAU_ONNX=model.int8.onnx
