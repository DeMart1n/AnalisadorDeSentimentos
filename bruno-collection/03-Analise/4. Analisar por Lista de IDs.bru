meta {
  name: 4. Analisar por Lista de IDs
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/conversas/analisar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "conversa_ids": [1, 2],
    "modelo": "lexico",
    "apenas_nao_classificadas": false
  }
}

tests {
  test("Status code deve ser 200 OK (ou 404 se IDs não existirem)", function() {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("Se analisado com sucesso (200), valida resposta", function() {
    if (res.getStatus() === 200) {
      const data = res.getBody();
      expect(data).to.have.property("total_conversas");
      expect(data).to.have.property("mensagens_classificadas");
      expect(data).to.have.property("modelo_utilizado");
    }
  });
}

docs {
  # POST /api/conversas/analisar (Por Lista de IDs)

  Permite submeter uma lista explícita de IDs de conversas para reanálise pontual.

  > 🔒 **Autenticação:** Rota protegida por JWT (`@jwt_required`).

  ### Parâmetros do Payload (JSON)
  | Campo | Obrigatório | Tipo | Descrição |
  |---|---|---|---|
  | `conversa_ids` | Sim | List[Int] | Lista de chaves primárias (`id`) das conversas a processar |
  | `modelo` | Não | String | `"lexico"`, `"classico"` ou `"bertimbau"` |
  | `apenas_nao_classificadas` | Não | Boolean | Se `false`, reclassifica mesmo as já calculadas |
}
