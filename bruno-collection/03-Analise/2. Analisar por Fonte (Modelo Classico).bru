meta {
  name: 2. Analisar por Fonte (Modelo Clássico)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/conversas/analisar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fonte": "{{fonte}}",
    "modelo": "classico",
    "apenas_nao_classificadas": true
  }
}

tests {
  test("Status code deve ser 200 OK (ou 404 se fonte não existir)", function() {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("Se analisado com sucesso (200), valida modelo clássico", function() {
    if (res.getStatus() === 200) {
      const data = res.getBody();
      expect(data).to.have.property("mensagens_classificadas");
      expect(data.modelo_utilizado).to.equal("classico");
    }
  });
}

docs {
  # POST /api/conversas/analisar (Modelo Clássico)

  Dispara a inferência das mensagens de usuário utilizando o modelo baseline **TF-IDF + Regressão Logística**.

  > 🔒 **Autenticação:** Rota protegida por JWT (`@jwt_required`).

  ### Respostas
  - `200 OK`: Sucesso.
  - `400 Bad Request`: Erro de validação.
  - `401 Unauthorized`: Falha de autenticação.
  - `404 Not Found`: Nenhuma conversa encontrada.
}
