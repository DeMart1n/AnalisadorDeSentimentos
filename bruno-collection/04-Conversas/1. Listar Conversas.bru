meta {
  name: 1. Listar Conversas (Todas)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/conversas?limite=100
  body: none
  auth: none
}

params:query {
  limite: 100
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data && data.conversas && data.conversas.length > 0) {
      bru.setEnvVar("conversaId", data.conversas[0].id);
    }
  }
}

tests {
  test("Status code deve ser 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Valida estrutura da listagem e paginação", function() {
    const data = res.getBody();
    expect(data).to.have.property("total");
    expect(data).to.have.property("conversas");
    expect(data.conversas).to.be.an("array");

    if (data.conversas.length > 0) {
      const conv = data.conversas[0];
      expect(conv).to.have.property("id");
      expect(conv).to.have.property("origem_id");
      expect(conv).to.have.property("fonte");
      expect(conv).to.have.property("indicadores");
    }
  });
}

docs {
  # GET /api/conversas

  Retorna a lista de conversas cadastradas acompanhadas dos indicadores consolidados da sessão.

  ### Automação no Bruno
  > O script `post-response` desta requisição captura automaticamente o ID da primeira conversa retornada e atualiza a variável de ambiente `conversaId`, facilitando a chamada subsequente de detalhes da conversa!

  ### Query Parameters
  | Parâmetro | Tipo | Padrão | Descrição |
  |---|---|---|---|
  | `limite` | Inteiro | 100 | Quantidade máxima de registros retornados (máximo: 500) |
  | `fonte` | String | - | (Opcional) Filtrar por nome da base |

  ### Indicadores da Conversa
  - `abertura`: Sentimento da primeira mensagem do usuário (`positivo`, `negativo`, `neutro`)
  - `encerramento`: Sentimento da última mensagem do usuário
  - `delta`: Variação de sentimento ao longo da conversa
  - `trocas_de_polaridade`: Quantidade de oscilações de sentimento
  - `pior_momento`: Posição/ordem da mensagem mais negativa
  - `n_mensagens`: Total de mensagens de usuário na conversa
}
